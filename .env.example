# =====================================================================
# The Last House on Maple Street - environment variables
# Copy to .env (cp .env.example .env) and fill in only what you need.
# Never commit .env. Never paste real keys into issues, logs or saves.
#
# Classic Story Mode needs NONE of these values.
# Legend: [local] local build, [hosted] Vercel deployment,
#         [assets] asset generation tools, (required)/(optional)
# =====================================================================

# ---- App ------------------------------------------------------------
# [local+hosted] (optional) local | hosted. Default local.
APP_MODE=local
# [local] (optional) local API server port. Default 3000.
PORT=3000
# [local] (optional) Vite dev server port. Default 5173.
CLIENT_PORT=5173

# ---- LLM for the Angel (AI-Enhanced Mode) ---------------------------
# [local] (optional) You can leave these empty and enter a provider in the
#         game UI instead; UI-entered keys stay in server memory only.
#         Use LLM_PROTOCOL=mock to try AI mode with no key at all.
# [hosted] (required for AI) The fixed provider used by the hosted build.
# Protocol: openai (Chat Completions format) | anthropic (Messages format) | mock
LLM_PROTOCOL=mock
# Full base URL of an OpenAI- or Anthropic-compatible API, e.g.
#   https://api.deepseek.com          (openai)
#   https://api.deepseek.com/anthropic (anthropic)
#   https://api.x.ai/v1               (openai)
#   https://api.minimax.io/v1         (openai; region dependent)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# [hosted] (required for the spend ceiling) USD per million tokens.
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# ---- Hosted access control (Vercel only) ----------------------------
# [hosted] (required for AI) Comma-separated label:sha256hex pairs.
# Generate with the tools/hash-access-code script (planned). Never store plain codes.
ACCESS_CODE_HASHES=
# [hosted] (required) Long random string used to sign session cookies.
SESSION_SECRET=
# [hosted] (optional) AI session lifetime in minutes. Default 120.
SESSION_TTL_MINUTES=120

# ---- Hosted usage store (Upstash Redis via Vercel Marketplace) ------
# [hosted] (required) If the integration injects KV_REST_API_URL /
# KV_REST_API_TOKEN instead, map them to these names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Hosted limits ---------------------------------------------------
# [hosted] (required) Hard ceiling on total AI spend in USD. AI stops at this value.
AI_SPEND_CEILING_USD=25
# [hosted] (optional) Chat requests allowed per access code (lifetime).
QUOTA_CHAT_PER_CODE=150
# [hosted] (optional) Chat requests allowed per 2-hour session.
QUOTA_CHAT_PER_SESSION=40
# [local+hosted] (optional) Chat requests per minute per session/IP.
RATE_LIMIT_PER_MINUTE=10
# [hosted] (optional) Simultaneous AI requests per code and overall.
CONCURRENCY_PER_CODE=1
CONCURRENCY_GLOBAL=8

# ---- Voice (ElevenLabs) ----------------------------------------------
# [assets] (optional) Used by the voice generation tool for authored lines.
# [hosted] (optional) Also used for limited live Angel voice if enabled.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_VOICE_ID_ANGEL=
ELEVENLABS_VOICE_ID_FELIX=
ELEVENLABS_VOICE_ID_ELENA=
ELEVENLABS_VOICE_ID_GARTNER=
ELEVENLABS_VOICE_ID_BRIGGS=
ELEVENLABS_VOICE_ID_WATCHER=
ELEVENLABS_VOICE_ID_ROSALIND=
ELEVENLABS_VOICE_ID_SMOKE=
# Voice tool: node tools/gen-voice.mjs (account, models, voices, sample, line, design, keep, library, add).
ELEVENLABS_VOICE_ID_WATCHER=
ELEVENLABS_VOICE_ID_NEIGHBOUR=
ELEVENLABS_VOICE_ID_ROSALIND=
# The smoke: a designed voice, layered and processed after generation.
ELEVENLABS_VOICE_ID_SMOKE=
# [hosted] (optional) true enables live Angel TTS in AI mode. Default false.
FEATURE_LIVE_TTS=false
# [hosted] (optional) Live TTS characters allowed per access code.
QUOTA_TTS_CHARS_PER_CODE=6000

# ---- Image generation -------------------------------------------------
# [assets] (optional) Provider used by the image generation tool.
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=

# ---- Asset tooling ----------------------------------------------------
# [assets] (optional) Where raw generator output goes (git-ignored).
RAW_ASSET_DIR=./assets/raw