# Copy to .env and fill in. Never commit .env.

# ---- App ----
APP_MODE=local            # local | hosted
PORT=3000

# ---- LLM (Angel, AI-Enhanced mode) ----
# Local mode: you can leave these empty and enter a key in the game UI (held in server memory only).
# Hosted mode: required.
LLM_PROVIDER=openai       # openai | gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Hosted demo only ----
SESSION_SECRET=
JUDGE_ACCOUNTS=           # hashed credentials, never plain text
LEDGER_PATH=./data/ledger.sqlite

# ---- Asset generation tooling (local only, outputs are git-ignored) ----
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_ANGEL=
ELEVENLABS_VOICE_ID_FELIX=
ELEVENLABS_VOICE_ID_ELENA=
ELEVENLABS_VOICE_ID_GARTNER=
ELEVENLABS_VOICE_ID_WATCHER=
VOICE_OUTPUT_DIR=./assets/voice

# Image/texture generation provider key (optional, whichever tool you use)
IMAGE_GEN_API_KEY=
GRAPHICS_OUTPUT_DIR=./assets/generated

# ---- Feature flags ----
FEATURE_TTS=false