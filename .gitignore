# ---------------------------------------------------------------
# Secrets and local config. Never commit.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
.vercel/

# ---------------------------------------------------------------
# Raw generator output (ElevenLabs takes, image-gen drafts, Blender
# working exports). Final, optimised exports are committed under
# apps/client/public/assets/ so a fresh clone runs.
# ---------------------------------------------------------------
assets/raw/

# Dependencies and build output
node_modules/
dist/
build/
coverage/
.vite/
*.tsbuildinfo
playwright-report/
test-results/
# Manual playtest screenshots (large PNGs, kept local)
/test/

# Local runtime data
data/
*.sqlite
*.sqlite-journal

# Blender backups
*.blend1
*.blend2

# Logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# NOTE: do NOT ignore .kiro/. The hackathon requires it in the repository.